{
  "name": "citylanduz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "server",
    "video"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "build": "npm run build -w @shahar/web && npm run build -w @shahar/admin",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "masterplan": "node packages/shared/scripts/build-masterplan.ts",
    "seed": "node packages/shared/scripts/build-seed.ts",
    "models": "node blender/build-models.mjs",
    "showcase": "node blender/build-showcase.mjs --open",
    "e2e": "node e2e/run.mjs",
    "video": "node video/src/main.ts",
    "carousel": "node video/src/carousel.ts",
    "og": "node scripts/build-og.mjs",
    "screens": "node e2e/screens.mjs",
    "chat-images": "node scripts/build-chat-images.mjs",
    "icons": "node scripts/build-icons.mjs",
    "textures": "node blender/build-textures.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
